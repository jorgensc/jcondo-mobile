<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jc_fundo"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barra"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/jc_azul_800"
        app:navigationIcon="@drawable/ic_voltar"
        app:navigationIconTint="@color/jc_branco"
        app:titleTextColor="@color/jc_branco" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/esp_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Cartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/esp_g">

                    <TextView
                        android:id="@+id/ocStatus"
                        style="@style/Etiqueta"
                        android:background="@drawable/bg_etiqueta_azul"
                        android:textColor="@color/jc_azul_600" />

                    <TextView
                        android:id="@+id/ocTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/esp_m"
                        android:textAppearance="@style/Texto.Titulo" />

                    <TextView
                        android:id="@+id/ocProtocolo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/esp_xs"
                        android:textAppearance="@style/Texto.Apoio"
                        android:textColor="@color/jc_azul_600" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/esp_m"
                        android:background="@color/jc_borda" />

                    <TextView
                        android:id="@+id/ocCategoria"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/esp_m"
                        android:textAppearance="@style/Texto.Apoio" />

                    <TextView
                        android:id="@+id/ocDescricao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/esp_s"
                        android:lineSpacingMultiplier="1.3"
                        android:textAppearance="@style/Texto.Corpo"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/ocDatas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/esp_g"
                        android:textAppearance="@style/Texto.Apoio"
                        android:textColor="@color/jc_texto_desabilitado" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ocRespostaCartao"
                style="@style/Cartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/esp_m"
                android:visibility="gone"
                app:cardBackgroundColor="@color/jc_azul_50">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/esp_m">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ocorrencia_resposta_admin"
                        android:textAppearance="@style/Texto.Secao" />

                    <TextView
                        android:id="@+id/ocResposta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/esp_s"
                        android:lineSpacingMultiplier="1.3"
                        android:textAppearance="@style/Texto.Corpo" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
