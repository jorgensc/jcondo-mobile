<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reservaCartao"
    style="@style/Cartao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/esp_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/esp_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circulo_azul"
                android:contentDescription="@string/desc_icone_reserva"
                android:padding="8dp"
                android:src="@drawable/ic_reservas" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/esp_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/reservaArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Texto.Corpo"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/reservaData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/Texto.Apoio" />

            </LinearLayout>

            <TextView
                android:id="@+id/reservaStatus"
                style="@style/Etiqueta"
                android:background="@drawable/bg_etiqueta_verde"
                android:textColor="@color/jc_sucesso" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/esp_s"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:alpha="0.6"
                android:contentDescription="@null"
                android:src="@drawable/ic_relogio" />

            <TextView
                android:id="@+id/reservaHorario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/esp_xs"
                android:layout_weight="1"
                android:textAppearance="@style/Texto.Apoio" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reservaCancelarBotao"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/esp_xs"
            android:minHeight="@dimen/alvo_toque"
            android:text="@string/reservas_cancelar"
            android:textColor="@color/jc_erro" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
