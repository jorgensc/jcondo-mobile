<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela de login. O cartao branco sobe sobre o fundo azul para separar
    identidade visual (topo) de acao (formulario), e o campo de servidor fica
    recolhido por padrao: ele so interessa a quem esta testando a aplicacao.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jc_azul_800"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/esp_g"
        android:paddingEnd="@dimen/esp_g"
        android:paddingTop="@dimen/esp_xg"
        android:paddingBottom="@dimen/esp_g">

        <ImageView
            android:id="@+id/logoImagem"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:contentDescription="@string/desc_logo"
            android:src="@drawable/logo_jcondo" />

        <TextView
            android:id="@+id/tituloApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/esp_m"
            android:letterSpacing="0.02"
            android:text="@string/app_name"
            android:textColor="@color/jc_branco"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtituloApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/esp_xs"
            android:text="@string/app_slogan"
            android:textColor="@color/jc_azul_100"
            android:textSize="15sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cartaoLogin"
            style="@style/Cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/esp_xg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/esp_g">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_titulo"
                    android:textAppearance="@style/Texto.Titulo" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailLayout"
                    style="@style/CampoTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/esp_m"
                    android:hint="@string/login_email"
                    app:startIconDrawable="@drawable/ic_email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/emailInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/senhaLayout"
                    style="@style/CampoTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/esp_s"
                    android:hint="@string/login_senha"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_senha">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/senhaInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/entrarBotao"
                    style="@style/BotaoPrincipal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/esp_g"
                    android:text="@string/login_entrar" />

                <ProgressBar
                    android:id="@+id/progresso"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/esp_s"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/esqueciTexto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/esp_m"
                    android:minHeight="@dimen/alvo_toque"
                    android:gravity="center"
                    android:paddingStart="@dimen/esp_s"
                    android:paddingEnd="@dimen/esp_s"
                    android:text="@string/login_esqueci"
                    android:textColor="@color/jc_azul_600"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/configServidorBotao"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/esp_m"
            android:text="@string/login_config_servidor"
            android:textColor="@color/jc_azul_100"
            app:icon="@drawable/ic_config"
            app:iconTint="@color/jc_azul_100" />

        <LinearLayout
            android:id="@+id/servidorGrupo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                style="@style/Cartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/esp_m">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/servidorLayout"
                        style="@style/CampoTexto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/login_endereco_api">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/servidorInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/esp_xs"
                        android:text="@string/login_endereco_ajuda"
                        android:textAppearance="@style/Texto.Apoio" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/salvarServidorBotao"
                        style="@style/BotaoSecundario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/esp_s"
                        android:text="@string/login_salvar_servidor" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
