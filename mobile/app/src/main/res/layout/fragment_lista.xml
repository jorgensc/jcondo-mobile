<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout compartilhado pelas telas de Avisos, Reservas e Ocorrencias.
    As tres tem a mesma estrutura - titulo, lista, estado e uma acao
    principal - entao reaproveitar o arquivo garante que se comportem
    igual e reduz a chance de divergencia visual entre elas.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raizLista"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jc_fundo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tituloLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/jc_branco"
            android:paddingStart="@dimen/esp_m"
            android:paddingEnd="@dimen/esp_m"
            android:paddingTop="@dimen/esp_m"
            android:paddingBottom="@dimen/esp_m"
            android:textAppearance="@style/Texto.Titulo" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/jc_borda" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeLista"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listaRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/esp_m"
                    android:paddingEnd="@dimen/esp_m"
                    android:paddingTop="@dimen/esp_m"
                    android:paddingBottom="96dp"
                    android:scrollbars="vertical" />

                <include
                    android:id="@+id/estado"
                    layout="@layout/view_estado" />

            </FrameLayout>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAcao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/esp_m"
        android:backgroundTint="@color/jc_azul_800"
        android:textColor="@color/jc_branco"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/jc_branco" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
